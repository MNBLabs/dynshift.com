---
/**
 * /brand/: the logos, palette and type, and how to use the name and logo.
 * DRAFT until approved: built only by the dev server, from
 * src/drafts/brand/. A production build has no /brand/ page.
 */
import Base from "../../layouts/Base.astro";
import { draftComponent } from "../../lib/drafts";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { b: undefined } }] : [];
}

const Brand = await draftComponent("brand/Brand.astro");
const Pin = await draftComponent("Pin.astro");
---

<Base
  title="Brand"
  description="The DynShift mark and logos to download, the colours and type around them, and how to use the name and logo when you write about DynShift or its projects."
  noindex
>
  {Pin && <Pin label="Brand page" />}
  {Brand ? <Brand /> : <p class="wrap">No brand page.</p>}
</Base>
