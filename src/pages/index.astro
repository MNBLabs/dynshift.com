---
import Base from "../layouts/Base.astro";
import BlackHole from "../components/BlackHole.astro";
import ProjectTile from "../components/ProjectTile.astro";
import { projects, packages } from "../data/projects";
import { GITHUB, CONTACT } from "../consts";
---

<Base>
  <section class="hero">
    <BlackHole />
    <div class="wrap">
      <div class="copy">
        <h1>Tools worth keeping.</h1>
        <p class="lede">
          DynShift is an independent software studio. It builds focused,
          well-made tools, most of them open source, and ships them finished.
        </p>
        <div class="actions">
          <a class="btn" href="#projects">See the projects</a>
          <a class="quiet" href={GITHUB} rel="noopener">Source on GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="projects">
    <div class="wrap">
      <div class="heading">
        <h2>Projects</h2>
        <p class="muted">
          Each one lives on its own site and is maintained there.
          <a href="/projects/">Where each stands</a>.
        </p>
      </div>
      <div class="tiles">
        {projects.map((p) => <ProjectTile project={p} />)}
      </div>

      <div class="pkgs">
        <h3>Packages</h3>
        <p class="muted small">
          Smaller pieces for Flutter, on pub.dev. All MIT.
          <a href="/packages/">What each one is for</a>.
        </p>
        <ul>
          {
            packages.map((k) => (
              <li>
                <a href={k.url} rel="noopener">
                  <code>{k.name}</code>
                </a>
                <span>{k.summary}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="studio" class="studio">
    <div class="wrap grid">
      <h2>The studio</h2>
      <div class="prose-cols">
        <p>
          DynShift makes things one at a time and finishes them. A tool leaves
          the studio when it does the whole job it set out to do, when it has
          been measured rather than assumed to work, and when it reads well
          enough that somebody else could maintain it.
        </p>
        <p>
          Most of the work is open source and published under
          <a href={GITHUB} rel="noopener">MNBLabs</a> on GitHub. DynShift is
          also home to Privogram, a private social app that has not been
          released yet.
        </p>
        <p>
          Software is the starting point. The intention is to grow from here
          into games, and further out into hardware. New projects will appear
          on this page as they ship.
        </p>
        <p>
          <a href="/studio/">More about how the studio works</a>, what it
          publishes under which licence, and who runs it.
        </p>
        <p class="contact">
          <a href={`mailto:${CONTACT}`}>{CONTACT}</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    position: relative;
    isolation: isolate;
    /* The header sits above the sky, so the sky starts under it. */
    margin-top: -80px;
    padding-top: 80px;
    min-height: min(100svh, 880px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero .wrap {
    padding-block: clamp(48px, 8vw, 96px);
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    /* Wide enough for the line to breathe, narrow enough to stay clear of
       the disk on a tablet; the renderer keeps the hole on the right. */
    max-width: min(600px, 54%);
  }
  .copy h1 {
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.7);
  }
  .lede {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink2);
    max-width: 40ch;
    text-wrap: pretty;
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.9);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: 8px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 13px 22px;
    background: var(--ink);
    color: var(--ground);
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition:
      transform var(--beat),
      background var(--beat);
  }
  .btn:hover {
    background: #fff;
    transform: translateY(-1px);
  }
  .btn:active {
    transform: scale(0.98);
  }
  .quiet {
    color: var(--ink2);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration-color: transparent;
  }
  .quiet:hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }

  /* One authored entrance: the words arrive, once. The sky fades in on its
     own when the renderer is ready. */
  .copy > * {
    animation: arrive 900ms var(--ease) both;
  }
  .copy > :nth-child(2) {
    animation-delay: 70ms;
  }
  .copy > :nth-child(3) {
    animation-delay: 140ms;
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  /* On a tablet the renderer keeps its desktop composition, and the disk's
     stream crosses the middle of the frame; the lower left stays dark, so
     the words go there. */
  @media (min-width: 768px) and (max-width: 1099px) {
    .hero {
      align-items: flex-end;
    }
    .hero .wrap {
      padding-block: 48px 72px;
    }
    .copy {
      max-width: min(520px, 62%);
    }
    .lede {
      max-width: 36ch;
    }
  }

  /* The phone composition is its own: the renderer centres the hole and
     darkens a band across the middle for exactly this, so the words sit
     centred in that band with the disk above and below them. */
  @media (max-width: 767px) {
    .hero {
      min-height: 100svh;
      align-items: center;
    }
    .hero .wrap {
      padding-block: 64px;
    }
    .copy {
      max-width: 34rem;
      margin-inline: auto;
      align-items: center;
      text-align: center;
      gap: 20px;
    }
    .copy h1 {
      font-size: clamp(2.6rem, 12vw, 3.4rem);
    }
    .lede {
      font-size: 1.02rem;
      max-width: 32ch;
    }
    .actions {
      flex-direction: column;
      gap: 18px;
      margin-top: 10px;
    }
  }

  /* ---- projects ---- */
  .projects {
    padding-block: clamp(24px, 4vw, 48px);
  }
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 26px;
  }
  .heading p {
    margin: 0;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 18px;
  }
  .pkgs {
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .pkgs h3 {
    font-size: 1.15rem;
  }
  .pkgs p {
    margin: 4px 0 18px;
  }
  .pkgs ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 8px 32px;
  }
  .pkgs li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink2);
    font-size: 0.95rem;
  }
  .pkgs code {
    font-family: var(--mono);
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--ink);
  }
  .pkgs li a {
    text-decoration-color: transparent;
  }
  .pkgs li a:hover {
    text-decoration-color: var(--accent);
  }

  /* ---- studio ---- */
  .studio {
    padding-top: clamp(56px, 9vw, 112px);
  }
  .studio .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 24px clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .prose-cols p {
    color: var(--ink2);
    font-size: 1.04rem;
    max-width: 58ch;
    text-wrap: pretty;
  }
  .contact {
    margin-top: 1.6em;
    font-weight: 500;
  }

  @media (max-width: 820px) {
    .studio .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
