---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="There is no page at this address.">
  <section class="wrap">
    <h1>Nothing here.</h1>
    <p class="muted">
      There is no page at this address. The projects are on the
      <a href="/">home page</a>.
    </p>
  </section>
</Base>

<style>
  section {
    padding-block: clamp(48px, 10vw, 120px);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 4rem);
    margin-bottom: 0.4em;
  }
</style>
