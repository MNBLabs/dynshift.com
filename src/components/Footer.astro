---
import { GITHUB, INSTAGRAM, CONTACT } from "../consts";
import Wordmark from "./Wordmark.astro";
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div class="id"><Wordmark size="footer" /></div>
      <nav aria-label="Footer">
        <a href="/#projects">Projects</a>
        <a href="/#studio">Studio</a>
        <a href="/privacy/">Privacy</a>
        <a href={GITHUB} rel="noopener">GitHub</a>
        <a href={INSTAGRAM} rel="noopener">Instagram</a>
        <a href={`mailto:${CONTACT}`}>{CONTACT}</a>
      </nav>
    </div>
    <p class="legal meta">© {year} DynShift. All rights reserved.</p>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(64px, 10vw, 120px);
    padding-block: 40px 48px;
    border-top: 1px solid var(--line);
    font-size: 0.94rem;
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
  }
  .id {
    display: inline-flex;
    opacity: 0.92;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  nav a {
    color: var(--ink2);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ink);
  }
  .legal {
    margin: 28px 0 0;
    max-width: none;
    color: var(--ink3);
  }
  @media (max-width: 640px) {
    .cols {
      flex-direction: column;
      align-items: flex-start;
    }
    nav {
      gap: 10px 20px;
    }
  }
</style>
