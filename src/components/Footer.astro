---
import { GITHUB, INSTAGRAM, CONTACT } from "../consts";
import Wordmark from "./Wordmark.astro";
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div class="id"><Wordmark size="footer" /></div>
      <nav aria-label="Footer">
        <a href="/projects/">Projects</a>
        <a href="/packages/">Packages</a>
        <a href="/studio/">Studio</a>
        <a href={GITHUB} rel="noopener">GitHub</a>
        <a href={INSTAGRAM} rel="noopener">Instagram</a>
        <a href={`mailto:${CONTACT}`}>{CONTACT}</a>
      </nav>
    </div>
    {/*
      The legal row, identical in purpose on all three DynShift sites.
      "Privacy settings" is always there and opens the shared panel
      (public/privacy.js). The Do Not Sell or Share link appears only where
      Google reports that a US state regulation applies to the reader.
    */}
    <nav class="legal-nav meta" aria-label="Legal">
      <a href="/privacy/">Privacy</a>
      <a href="/cookies/">Cookies</a>
      <a href="/terms/">Terms</a>
      <a href="/contact/">Contact &amp; grievances</a>
      <button type="button" data-privacy-settings>Privacy settings</button>
      <a href="/privacy/#your-choices" class="dns" data-dns-link>Do Not Sell or Share My Personal Information</a>
    </nav>
    <p class="legal meta">© {year} DynShift. All rights reserved.</p>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(64px, 10vw, 120px);
    padding-block: 40px 48px;
    border-top: 1px solid var(--line);
    font-size: 0.94rem;
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
  }
  .id {
    display: inline-flex;
    opacity: 0.92;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  nav a,
  nav button {
    color: var(--ink2);
    text-decoration: none;
    padding-block: 6px;
  }
  nav button {
    font: inherit;
    background: none;
    border: 0;
    padding-inline: 0;
    cursor: pointer;
  }
  nav a:hover,
  nav button:hover {
    color: var(--ink);
  }
  .legal-nav {
    margin-top: 28px;
    gap: 6px 20px;
  }
  .legal-nav a,
  .legal-nav button {
    color: var(--ink3);
  }
  .dns {
    display: none;
  }
  :global(html[data-us-privacy]) .dns {
    display: inline;
  }
  .legal {
    margin: 12px 0 0;
    max-width: none;
    color: var(--ink3);
  }
  @media (max-width: 640px) {
    .cols {
      flex-direction: column;
      align-items: flex-start;
    }
    nav {
      gap: 10px 20px;
    }
  }
</style>
