---
import { GITHUB, INSTAGRAM, CONTACT } from "../consts";
import Logo from "./Logo.astro";
import { getArticles } from "../lib/articles";
const year = new Date().getFullYear();
const hasArticles = (await getArticles()).length > 0;
---

<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <a class="id" href="/" aria-label="DynShift home"><Logo height={26} id="foot-logo" /></a>
      <nav aria-label="Footer">
        <a href="/projects/">Projects</a>
        <a href="/packages/">Packages</a>
        {hasArticles && <a href="/articles/">Articles</a>}
        <a href="/studio/">Studio</a>
        <a href="/brand/">Brand</a>
        <a href={GITHUB} rel="noopener">GitHub</a>
        <a href={INSTAGRAM} rel="noopener">Instagram</a>
        <a href={`mailto:${CONTACT}`}>{CONTACT}</a>
      </nav>
    </div>
    {/*
      The legal row, identical in purpose on all three DynShift sites.
      "Privacy settings" is always there and opens the shared panel
      (public/privacy.js). The Do Not Sell or Share link appears only where
      Google reports that a US state regulation applies to the reader.
    */}
    <div class="base meta">
      <p class="legal">© {year} DynShift. All rights reserved.</p>
      <nav class="legal-nav" aria-label="Legal">
        <a href="/privacy/">Privacy</a>
        <a href="/cookies/">Cookies</a>
        <a href="/terms/">Terms</a>
        <a href="/contact/">Contact</a>
        <button type="button" data-privacy-settings>Privacy settings</button>
        <a href="/privacy/#your-choices" class="dns" data-dns-link>Do Not Sell or Share My Personal Information</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(64px, 10vw, 120px);
    padding-block: 40px 48px;
    border-top: 1px solid var(--line);
    font-size: 0.94rem;
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
  }
  /* The stylised logo, in the footer's link colour; it brightens with the
     links around it. The negative margin lifts the lettering's baseline onto
     the nav's text baseline, since the y and the f descend below it. */
  .id {
    display: inline-flex;
    color: var(--ink2);
    border-radius: var(--r-s);
    margin-block: -2px 0;
    transition: color var(--beat);
  }
  .id:hover {
    color: var(--ink);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  nav a,
  nav button {
    color: var(--ink2);
    text-decoration: none;
    padding-block: 6px;
  }
  nav button {
    font: inherit;
    background: none;
    border: 0;
    padding-inline: 0;
    cursor: pointer;
  }
  nav a:hover,
  nav button:hover {
    color: var(--ink);
  }
  /* One quiet bottom row that mirrors the top one: the line on the left,
     the legal links on the right, both in the metadata voice. */
  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 32px;
    margin-top: 28px;
    color: var(--ink3);
  }
  .legal {
    margin: 0;
    max-width: none;
  }
  .legal-nav {
    gap: 4px 18px;
  }
  .legal-nav a,
  .legal-nav button {
    color: var(--ink3);
    padding-block: 2px;
  }
  .dns {
    display: none;
  }
  :global(html[data-us-privacy]) .dns {
    display: inline;
  }
  @media (max-width: 640px) {
    .cols {
      flex-direction: column;
      align-items: flex-start;
    }
    nav {
      gap: 10px 20px;
    }
    .base {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>
