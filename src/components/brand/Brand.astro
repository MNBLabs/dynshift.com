---
/**
 * /brand/: the DynShift logos, the palette and type around them, and
 * how to use the name and logo. Every logo shown is the designer's file from
 * public/brand/logo/, cropped to its measured bounds, never redrawn.
 */
import Art from "./Art.astro";
import BlackHole from "../BlackHole.astro";
import Cover from "../article/Cover.astro";
import { getArticles } from "../../lib/articles";
import { CONTACT } from "../../consts";

const articles = await getArticles();
const L = "/brand/logo/";

const logos = [
  {
    key: "mark",
    name: "The mark",
    use: "On its own wherever the space is square or small: icons, avatars, favicons.",
    file: "dynshift-mark",
  },
  {
    key: "horizontal",
    name: "Horizontal logo",
    use: "The mark beside the name. The default whenever there is room for both: page headers, documents, slides.",
    file: "dynshift-logo-horizontal",
  },
  {
    key: "stacked",
    name: "Stacked logo",
    use: "The name under the mark, for square spaces with room to spare: splash screens, posters, social images.",
    file: "dynshift-logo-stacked",
  },
  {
    key: "outline",
    name: "Stylised logo",
    use: "The name drawn with Δ for the D and δ for the S. The signature: this site's footer, closing slides, the end of a video.",
    file: "dynshift-stylised-outline",
  },
  {
    key: "solid",
    name: "Stylised logo, solid",
    use: "The same drawing with a filled triangle, for small sizes and rough print, where the outline's thin strokes would fill in.",
    file: "dynshift-stylised-solid",
  },
] as const;

const neutrals = [
  { name: "Ground", hex: "#0d0d0d", role: "The page" },
  { name: "Raised", hex: "#151515", role: "Panels and code" },
  { name: "Raised 2", hex: "#1b1b1c", role: "Cards and controls" },
  { name: "Ink", hex: "#f3f2f6", role: "Text, and the logo on screen" },
  { name: "Ink 2", hex: "#a8a6b4", role: "Secondary text" },
  { name: "Ink 3", hex: "#7a788b", role: "Metadata" },
];
const light = [
  { name: "Accent", hex: "#ff3d9e", role: "Links, focus and the one highlight" },
  { name: "Ember", hex: "#ff6444", role: "Flow and output in diagrams" },
  { name: "Gold", hex: "#ffc46b", role: "Strings in code" },
  { name: "Teal", hex: "#2ed3c4", role: "The network and data in diagrams" },
];

const sizes = [
  { key: "mark", h: 16, label: "Mark, 16 px" },
  { key: "horizontal", h: 24, label: "Horizontal, 24 px" },
  { key: "outline", h: 20, label: "Stylised, 20 px" },
  { key: "stacked", h: 72, label: "Stacked, 72 px" },
] as const;

const forms = [
  { text: "DynShift", ok: true },
  { text: "Dynshift", ok: false },
  { text: "Dyn Shift", ok: false },
  { text: "DYNSHIFT", ok: false },
];
---

<div class="brand">
  <section class="hero">
    <BlackHole />
    <div class="wrap">
      <div class="copy">
        <Art name="mark" id="hero" class="hero-mark" />
        <h1>Brand</h1>
        <p class="lede">
          The DynShift mark and logos, the colours and type around them, and
          how to use them when you write about DynShift or its projects. Every
          file here is the original artwork.
        </p>
        <div class="actions">
          <a class="btn" href="/brand/dynshift-logos.zip" download>Download all logos</a>
          <a class="quiet" href="#use-h">How to use them</a>
        </div>
        <p class="meta zip">ZIP, 196 KB: SVG and PNG, white and black</p>
      </div>
    </div>
  </section>

  <section class="wrap block split" aria-labelledby="mark-h">
    <div class="text">
      <h2 id="mark-h">The mark</h2>
      <p>
        A lowercase delta cut out of an uppercase one. Delta is the usual
        symbol for change.
      </p>
      <p>
        The triangle is equilateral, with its corners slightly softened. The
        δ is open space, not a second colour, so the mark is always one flat
        colour and whatever is behind it shows through. It is this site's
        favicon and app icon.
      </p>
    </div>
    <figure class="construct">
      <svg viewBox="-60 -60 686 560" role="img" aria-labelledby="construct-t">
        <title id="construct-t">
          The mark with its construction: an equilateral triangle with sixty-degree corners, whose softened
          corners sit just inside the sharp outline.
        </title>
        <image href={`${L}dynshift-mark-white.svg`} x="0" y="0" width="566" height="566" />
        <path d="M37.9 424.5 L283 0 L528.1 424.5 Z" class="guide" />
        <path d="M-40 424.5 H606" class="guide faint" />
        <path d="M283 0 L306 -40 M283 0 L260 -40" class="guide faint" />
        <path d="M97.9 424.5 A60 60 0 0 0 67.9 372.5" class="arc" />
        <path d="M468.1 424.5 A60 60 0 0 1 498.1 372.5" class="arc" />
        <text x="37.9" y="478" class="lab">60°</text>
        <text x="528.1" y="478" class="lab">60°</text>
        <circle cx="283" cy="0" r="6" class="dot" />
        <circle cx="37.9" cy="424.5" r="6" class="dot" />
        <circle cx="528.1" cy="424.5" r="6" class="dot" />
      </svg>
    </figure>
  </section>

  <section class="wrap block logos" aria-labelledby="logos-h">
    <div class="head">
      <div>
        <h2 id="logos-h">The logos</h2>
        <p class="muted">
          Five drawings, each in white for dark backgrounds and black for
          light ones.
        </p>
      </div>
      <fieldset class="seg">
        <legend class="sr">Background</legend>
        <label><input type="radio" name="bg" value="dark" checked /><span>Dark</span></label>
        <label><input type="radio" name="bg" value="light" id="bg-light" /><span>Light</span></label>
      </fieldset>
    </div>
    <div class="family">
      {
        logos.map((l) => (
          <figure class:list={["tile", `t-${l.key}`]}>
            <div class="board">
              <Art name={l.key} id={`fam-${l.key}`} class="fam-art" />
            </div>
            <figcaption>
              <h3>{l.name}</h3>
              <p>{l.use}</p>
              <p class="dl meta">
                <a href={`${L}${l.file}-white.svg`} download>White SVG</a>
                <a href={`${L}${l.file}-black.svg`} download>Black SVG</a>
              </p>
            </figcaption>
          </figure>
        ))
      }
      <figure class="tile t-type">
        <div class="board">
          <span class="typed">DynShift</span>
        </div>
        <figcaption>
          <h3>The name in type</h3>
          <p>
            In running text and navigation the name is typed, not drawn: Geist
            SemiBold, tracking −0.035em, as in this site's header.
          </p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="space-h">
    <h2 id="space-h">Space and size</h2>
    <div class="pair">
      <figure>
        <div class="board space-board">
          <div class="clear">
            <div class="inner"><Art name="horizontal" id="space" class="space-art" /></div>
            <span class="xl t" aria-hidden="true">x</span>
            <span class="xl r" aria-hidden="true">x</span>
            <span class="xl b" aria-hidden="true">x</span>
            <span class="xl l" aria-hidden="true">x</span>
          </div>
        </div>
        <figcaption>
          Keep clear space on every side at least <strong>x</strong>, half the
          height of the triangle. Nothing else sits inside it: no text, no
          edges, no other logos.
        </figcaption>
      </figure>
      <figure>
        <div class="board sizes">
          {
            sizes.map((s) => (
              <div class="size">
                <div class="size-art" style={`height:${s.h}px`}>
                  <Art name={s.key} id={`size-${s.key}`} decorative />
                </div>
                <span class="meta">{s.label}</span>
              </div>
            ))
          }
        </div>
        <figcaption>
          The smallest each logo goes on screen, shown here at actual size.
          Below these, use the mark on its own.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="colour-h">
    <div class="split">
      <div class="text">
        <h2 id="colour-h">Colour</h2>
        <p>
          The logo is one flat colour: white on dark backgrounds, black on
          light ones. It is never set in the accent, a gradient, or colours
          taken from a photograph.
        </p>
        <p>
          Around it, the site is near-black and quiet, with one accent. The
          warmer colours appear only where they carry meaning, in diagrams and
          code. Select a colour to copy its value.
        </p>
      </div>
      <div class="palette">
        <ul class="swatches three" aria-label="Neutrals">
          {
            neutrals.map((c) => (
              <li>
                <button type="button" class="sw" data-hex={c.hex} aria-label={`Copy ${c.name}, ${c.hex}`}>
                  <span class="chip" style={`background:${c.hex}`} />
                  <span class="nm">{c.name}</span>
                  <span class="hex meta">{c.hex}</span>
                  <span class="role">{c.role}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <ul class="swatches two" aria-label="Accent and the light">
          {
            light.map((c) => (
              <li>
                <button type="button" class="sw" data-hex={c.hex} aria-label={`Copy ${c.name}, ${c.hex}`}>
                  <span class="chip" style={`background:${c.hex}`} />
                  <span class="nm">{c.name}</span>
                  <span class="hex meta">{c.hex}</span>
                  <span class="role">{c.role}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <p class="copied meta" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="type-h">
    <h2 id="type-h">Type</h2>
    <div class="specimen">
      <div class="sp sp-sans">
        <span class="aa" aria-hidden="true">Aa</span>
        <div>
          <h3>Geist</h3>
          <p class="muted">Headings, text and the name. Regular, Medium and SemiBold.</p>
          <p class="glyphs" aria-hidden="true">ABCDEFGHIJKLM<br />abcdefghijklm<br />0123456789</p>
        </div>
      </div>
      <div class="sp sp-mono">
        <span class="aa" aria-hidden="true">Aa</span>
        <div>
          <h3>Geist Mono</h3>
          <p class="muted">Code, data and measurements, never as decoration.</p>
          <p class="glyphs" aria-hidden="true">{"{ } [ ] ( ) => ≤ ±"}<br />0123456789<br />40 bytes, 250 Hz</p>
        </div>
      </div>
    </div>
    <p class="muted small note">
      Both are by Vercel, released under the SIL Open Font License, and served
      from this site.
    </p>
  </section>

  <section class="wrap block" aria-labelledby="img-h">
    <div class="split narrow">
      <div class="text">
        <h2 id="img-h">Imagery</h2>
        <p>
          Pictures are monochrome and cinematic: space, light and matter, each
          standing for an idea rather than illustrating it. Diagrams are the
          opposite: drawn exactly, as SVG, in the palette above.
        </p>
      </div>
    </div>
    <div class="strip">
      {
        articles.map((a) => (
          <a href={`/articles/${a.slug}/`} class="frame">
            <Cover cover={a.cover} alt={a.coverAlt} ratio="3 / 4" />
            <span>{a.title}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap block" aria-labelledby="use-h">
    <h2 id="use-h">Using the name and logo</h2>
    <div class="forms">
      <ul aria-label="Writing the name">
        {
          forms.map((f) => (
            <li class:list={[{ ok: f.ok }]}>
              <svg viewBox="0 0 16 16" aria-hidden="true" class="ico">
                {f.ok ? <path d="M3.5 8.5l3 3 6-7" /> : <path d="M4.5 4.5l7 7m0-7l-7 7" />}
              </svg>
              <span class="form">{f.text}</span>
              <span class="sr">{f.ok ? "correct" : "incorrect"}</span>
            </li>
          ))
        }
      </ul>
      <p class="muted">
        One word, capital D and capital S. The lowercase <span class="meta">dynshift</span> belongs
        only in web and email addresses. The projects are written PhonePad and LAYR.
      </p>
    </div>

    <div class="donts">
      <figure>
        <div class="board ex"><Art name="mark" id="d-stretch" class="x-stretch" decorative /></div>
        <figcaption><span class="no">Don't</span> stretch, squash or skew it.</figcaption>
      </figure>
      <figure>
        <div class="board ex"><Art name="mark" id="d-rotate" class="x-rotate" decorative /></div>
        <figcaption><span class="no">Don't</span> rotate it.</figcaption>
      </figure>
      <figure>
        <div class="board ex"><Art name="mark" id="d-grad" gradient decorative /></div>
        <figcaption><span class="no">Don't</span> recolour it or fill it with a gradient.</figcaption>
      </figure>
      <figure>
        <div class="board ex"><Art name="mark" id="d-glow" class="x-glow" decorative /></div>
        <figcaption><span class="no">Don't</span> add shadows, glows or outlines.</figcaption>
      </figure>
      <figure>
        <div class="board ex">
          <span class="x-row"><span class="typed small-typed">DynShift</span><Art name="mark" id="d-order" decorative /></span>
        </div>
        <figcaption><span class="no">Don't</span> rearrange its parts or change their spacing.</figcaption>
      </figure>
      <figure>
        <div class="board ex">
          <span class="x-row"><Art name="mark" id="d-font" decorative /><span class="x-serif">DynShift</span></span>
        </div>
        <figcaption><span class="no">Don't</span> set the name in another typeface beside the mark.</figcaption>
      </figure>
      <figure>
        <div class="board ex x-busy"><Art name="mark" id="d-busy" class="x-low" decorative /></div>
        <figcaption><span class="no">Don't</span> place it where it loses contrast.</figcaption>
      </figure>
      <figure>
        <div class="board ex"><span class="x-badge"><Art name="mark" id="d-badge" decorative /></span></div>
        <figcaption><span class="no">Don't</span> enclose it in another shape.</figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="ask-h">
    <h2 id="ask-h">Asking first</h2>
    <p>
      DynShift and PhonePad are unregistered trademarks of DynShift, as the
      <a href="/terms/">terms</a> say. You are welcome to use the name and the
      logos on this page to refer to DynShift and its work: in articles,
      reviews, tutorials, talks, lists of tools, and a credit or link to a
      project.
    </p>
    <p>
      Ask first for anything else, including merchandise, the logo inside
      another product's name or icon, or anything that could suggest DynShift
      made, sponsors or endorses something it did not. Write to
      <a href={`mailto:${CONTACT}`}>{CONTACT}</a>.
    </p>
  </section>
</div>

<script>
  // Copy a swatch's value, and say so once in the live region.
  const status = document.querySelector<HTMLElement>(".copied");
  let timer: number | undefined;
  for (const b of document.querySelectorAll<HTMLButtonElement>(".sw")) {
    b.addEventListener("click", async () => {
      const hex = b.dataset.hex ?? "";
      try {
        await navigator.clipboard.writeText(hex);
        if (status) status.textContent = `Copied ${hex}`;
      } catch {
        if (status) status.textContent = hex;
      }
      document.querySelectorAll(".sw[data-on]").forEach((e) => e.removeAttribute("data-on"));
      b.setAttribute("data-on", "");
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        b.removeAttribute("data-on");
        if (status) status.textContent = "";
      }, 1600);
    });
  }
</script>

<style>
  .brand {
    --board: var(--raised);
    --art: #fff;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  figure {
    margin: 0;
  }

  /* ---- hero: the home page's sky, with the mark on its dark side ---- */
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    /* The same box as the home hero, so the sky renders identically. */
    min-height: min(100svh, 880px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero .wrap {
    padding-block: clamp(48px, 8vw, 96px);
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    max-width: min(560px, 52%);
  }
  /* The B of the heading starts 0.075em inside its box (its side bearing);
     the triangle's corner would sit on the box edge and look indented-out,
     so the mark steps in by the same amount and the two left edges agree. */
  .copy {
    --h1: clamp(2.8rem, 6.4vw, 5rem);
  }
  .copy :global(.hero-mark) {
    height: clamp(64px, 7vw, 92px);
    color: #fff;
    margin: 0 0 10px calc(var(--h1) * 0.075);
  }
  .copy h1 {
    font-size: var(--h1);
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.7);
  }
  .lede {
    margin: 0;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.55;
    color: var(--ink2);
    max-width: 42ch;
    text-wrap: pretty;
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.9);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: 6px;
  }
  .zip {
    margin: -6px 0 0;
    color: var(--ink3);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 13px 22px;
    background: var(--ink);
    color: var(--ground);
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition:
      transform var(--beat),
      background var(--beat);
  }
  .btn:hover {
    background: #fff;
    transform: translateY(-1px);
  }
  .btn:active {
    transform: scale(0.98);
  }
  .quiet {
    color: var(--ink2);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration-color: transparent;
  }
  .quiet:hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }
  /* One authored entrance: the mark, then the words, once. */
  .copy > :global(*) {
    animation: arrive 900ms var(--ease) both;
  }
  .copy > :global(:nth-child(2)) {
    animation-delay: 80ms;
  }
  .copy > :global(:nth-child(3)) {
    animation-delay: 150ms;
  }
  .copy > :global(:nth-child(n + 4)) {
    animation-delay: 220ms;
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(6px);
    }
  }
  @media (min-width: 768px) and (max-width: 1099px) {
    .hero {
      align-items: flex-end;
    }
    .hero .wrap {
      padding-block: 48px 72px;
    }
    .copy {
      max-width: min(500px, 62%);
    }
  }
  @media (max-width: 767px) {
    .hero {
      min-height: 100svh;
    }
    .hero .wrap {
      padding-block: 64px;
    }
    .copy {
      max-width: 34rem;
      margin-inline: auto;
      align-items: center;
      text-align: center;
      gap: 18px;
    }
    .copy {
      --h1: clamp(2.6rem, 12vw, 3.4rem);
    }
    /* Centred on a phone: no edge to align to. */
    .copy :global(.hero-mark) {
      margin-left: 0;
    }
    .lede {
      font-size: 1.02rem;
      max-width: 32ch;
    }
    .actions {
      flex-direction: column;
      gap: 18px;
    }
    /* Over the ring on a phone; the button says enough. */
    .zip {
      display: none;
    }
  }
  /* Short phones: the copy here is a little taller than the home page's, so
     it tightens until it fits the same box and the sky matches exactly. */
  @media (max-width: 767px) and (max-height: 700px) {
    .hero .wrap {
      padding-block: 40px;
    }
    .copy :global(.hero-mark) {
      height: 48px;
      margin-bottom: 4px;
    }
  }

  /* ---- sections ---- */
  .block {
    margin-top: clamp(80px, 11vw, 140px);
  }
  .hero + .block {
    margin-top: clamp(40px, 6vw, 72px);
  }
  .block > h2,
  .head h2,
  .text h2 {
    margin-bottom: 14px;
  }
  .text p,
  #ask-h ~ p {
    color: var(--ink2);
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .board {
    background: var(--board);
    border: 1px solid var(--line);
    border-radius: var(--r-l);
    color: var(--art);
    transition:
      background 420ms var(--ease),
      color 420ms var(--ease),
      border-color 420ms var(--ease);
  }

  /* construction */
  .construct {
    padding: clamp(20px, 4vw, 40px);
  }
  .construct svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .guide {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-dasharray: 10 9;
  }
  .guide.faint {
    stroke: var(--ink3);
  }
  .arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
  }
  .dot {
    fill: var(--accent);
  }
  .lab {
    fill: var(--ink2);
    font-family: var(--mono);
    font-size: 26px;
    text-anchor: middle;
  }

  /* the family */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px 32px;
    margin-bottom: 28px;
  }
  .head p {
    margin: 0;
  }
  .seg {
    display: inline-flex;
    margin: 0;
    padding: 4px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    gap: 2px;
  }
  .seg label {
    position: relative;
    cursor: pointer;
  }
  .seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    margin: 0;
  }
  .seg span {
    display: block;
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink2);
    transition:
      background var(--beat),
      color var(--beat);
  }
  .seg input:checked + span {
    background: var(--ink);
    color: var(--ground);
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--accent);
