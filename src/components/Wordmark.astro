---
/**
 * The header's wordmark, set in type: the brand at the top of every page is
 * the name in the site's own face, with no symbol beside it. The stylised
 * logo lives in the footer (Logo.astro) and the mark in the favicon.
 */
interface Props {
  size?: "header" | "footer";
}
const { size = "header" } = Astro.props;
---

<span class:list={["wordmark", size]}>DynShift</span>

<style>
  .wordmark {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 1.12rem;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--ink);
  }
  .wordmark.footer {
    font-size: 1rem;
    color: var(--ink2);
  }
</style>
