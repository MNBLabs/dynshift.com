---
/**
 * The wordmark, set in type. There is no mark on the site: the logo is not
 * final, and a wordmark that is simply the name in the site's own face
 * ages better than a placeholder.
 */
interface Props {
  size?: "header" | "footer";
}
const { size = "header" } = Astro.props;
---

<span class:list={["wordmark", size]}>DynShift</span>

<style>
  .wordmark {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 1.12rem;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--ink);
  }
  .wordmark.footer {
    font-size: 1rem;
    color: var(--ink2);
  }
</style>
