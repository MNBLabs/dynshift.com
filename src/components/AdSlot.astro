---
/**
 * One advertising slot.
 *
 * Renders **nothing** until an ad unit id is configured, and nothing on a
 * legal page whatever the caller asks. When it does render, it takes no room
 * and shows no label until Google has actually filled it: the rules and the
 * "Advertisement" label arrive with the ad, and an unfilled or blocked slot
 * stays collapsed. It is pushed only when it comes within about 600px of the
 * viewport (public/privacy.js), so it fills below the reader, not under them,
 * and carries restricted data processing when the browser sends Global
 * Privacy Control.
 *
 * Where a slot may appear is a decision, not a default: one per page, in the middle of long-form prose, never
 * on the home page, never in a list of projects, never on a legal page, and
 * never next to a link someone is reaching for.
 */
import { ADSENSE_PUBLISHER, ADSENSE_SLOT } from "../consts";

interface Props {
  /** Defaults to the single configured unit; without one there is nothing to render. */
  slot?: string;
}
const { slot = ADSENSE_SLOT } = Astro.props as Props;
const legal = /^\/(privacy|cookies|terms|contact)(\/|$)/.test(Astro.url.pathname);
const show = Boolean(slot) && !legal;
---

{
  show && (
    <aside class="ad" data-ad-slot-lazy aria-label="Advertisement">
      <span class="ad-label meta">Advertisement</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={`ca-${ADSENSE_PUBLISHER}`}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
    </aside>
  )
}

<style>
  /* Nothing at all until Google fills the slot. */
  .ad {
    display: block;
  }
  .ad-label {
    display: none;
  }
  /* Two hairlines and a label, in the site's own rules and type, and only
     around a real advertisement. Nothing that could be mistaken for a card,
     a button or a project tile: those are rounded and raised, and this is
     neither. */
  .ad:has(ins[data-ad-status="filled"]) {
    margin-block: clamp(2.75rem, 7vw, 4.5rem);
    padding-block: 14px 18px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .ad:has(ins[data-ad-status="filled"]) .ad-label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink3);
    margin-bottom: 12px;
  }
  .ad:has(ins[data-ad-status="unfilled"]) {
    display: none;
  }
  .adsbygoogle {
    margin: 0;
  }
</style>
