---
import { GITHUB } from "../consts";
import Wordmark from "./Wordmark.astro";

/* Each entry is a page of its own. The home page also has sections with the
   same names, but the header always goes to the page, so that the site reads
   as a site and not as one long scroll. */
const nav = [
  { href: "/projects/", label: "Projects" },
  { href: "/packages/", label: "Packages" },
  { href: "/studio/", label: "Studio" },
];
const path = Astro.url.pathname;
---

<header class="top">
  <div class="wrap row">
    <a class="brand" href="/" aria-label="DynShift home"><Wordmark /></a>
    <nav aria-label="Primary">
      {
        nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>
            {n.label}
          </a>
        ))
      }
      <a href={GITHUB} rel="noopener">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .top {
    position: relative;
    z-index: 1;
    padding-block: 22px;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    text-decoration: none;
    display: inline-flex;
  }
  nav {
    display: flex;
    gap: clamp(18px, 3vw, 32px);
    font-weight: 500;
    font-size: 0.92rem;
    letter-spacing: -0.005em;
  }
  nav a {
    color: var(--ink2);
    text-decoration: none;
    padding: 6px 0;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
  @media (max-width: 480px) {
    .top {
      padding-block: 18px;
    }
    nav {
      font-size: 0.88rem;
    }
  }
</style>
