---
import { GITHUB } from "../consts";
import Wordmark from "./Wordmark.astro";
import { getArticles } from "../lib/articles";

/* Each entry is a page of its own. The home page also has sections with the
   same names, but the header always goes to the page, so that the site reads
   as a site and not as one long scroll. Articles appears once there is one.

   Phones keep one row and the three main pages: GitHub, and Packages once
   Articles takes its place, are left to the footer, which lists every page. */
const hasArticles = (await getArticles()).length > 0;
const nav = [
  { href: "/projects/", label: "Projects", phone: true },
  { href: "/packages/", label: "Packages", phone: !hasArticles },
  ...(hasArticles ? [{ href: "/articles/", label: "Articles", phone: true }] : []),
  { href: "/studio/", label: "Studio", phone: true },
];
const path = Astro.url.pathname;
---

<header class="top">
  <div class="wrap row">
    <a class="brand" href="/" aria-label="DynShift home"><Wordmark /></a>
    <nav aria-label="Primary">
      {
        nav.map((n) => (
          <a href={n.href} class:list={{ wide: !n.phone }} aria-current={path.startsWith(n.href) ? "page" : undefined}>
            {n.label}
          </a>
        ))
      }
      <a href={GITHUB} class="wide" rel="noopener">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .top {
    position: relative;
    z-index: 1;
    padding-block: 22px;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    text-decoration: none;
    display: inline-flex;
    flex: none;
  }
  nav {
    display: flex;
    gap: clamp(18px, 3vw, 32px);
    font-weight: 500;
    font-size: 0.92rem;
    letter-spacing: -0.005em;
  }
  nav a {
    color: var(--ink2);
    text-decoration: none;
    padding: 6px 0;
    white-space: nowrap;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
  @media (max-width: 560px) {
    .row {
      gap: 16px;
    }
    nav {
      gap: clamp(14px, 4.5vw, 22px);
      font-size: clamp(0.84rem, 3.6vw, 0.92rem);
    }
    nav a {
      padding-block: 7px;
    }
    .wide {
      display: none;
    }
  }
</style>
