---
import { GITHUB } from "../consts";
import Wordmark from "./Wordmark.astro";
import { getArticles } from "../lib/articles";

/* Each entry is a page of its own. The home page also has sections with the
   same names, but the header always goes to the page, so that the site reads
   as a site and not as one long scroll. Articles appears once there is one. */
const hasArticles = (await getArticles()).length > 0;
const nav = [
  { href: "/projects/", label: "Projects" },
  { href: "/packages/", label: "Packages" },
  ...(hasArticles ? [{ href: "/articles/", label: "Articles" }] : []),
  { href: "/studio/", label: "Studio" },
];
const path = Astro.url.pathname;
---

<header class="top">
  <div class="wrap row">
    <a class="brand" href="/" aria-label="DynShift home"><Wordmark /></a>
    <nav aria-label="Primary">
      {
        nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>
            {n.label}
          </a>
        ))
      }
      <a href={GITHUB} rel="noopener">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .top {
    position: relative;
    z-index: 1;
    padding-block: 22px;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    text-decoration: none;
    display: inline-flex;
  }
  nav {
    display: flex;
    gap: clamp(18px, 3vw, 32px);
    font-weight: 500;
    font-size: 0.92rem;
    letter-spacing: -0.005em;
  }
  nav a {
    color: var(--ink2);
    text-decoration: none;
    padding: 6px 0;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
  /* Phones: the wordmark on its own line and the links spread across the
     next, so every link stays in the header at 320 px without crowding. The
     hero tucks under the header by --header-h (global.css), which follows. */
  @media (max-width: 560px) {
    .top {
      padding-block: 16px 8px;
    }
    .row {
      flex-wrap: wrap;
      gap: 6px 24px;
    }
    nav {
      width: 100%;
      justify-content: space-between;
      gap: 12px;
      font-size: 0.88rem;
    }
  }
</style>
