---
/**
 * The hero's sky: a black hole, rendered live.
 *
 * The renderer under src/hero is the vgpu "Optimized Black Hole" example,
 * pulled and hash-verified against its published manifest and kept as it
 * was published: one bake of the relativistic ray traversal into a G-buffer,
 * then per-frame disk shading, stars, antialiasing and HDR bloom, paced to
 * 60 fps, paused when hidden or scrolled away, and disposed with every GPU
 * resource on teardown. It follows the mouse a little; on a phone it sits
 * centred and lets the words come through.
 *
 * Without WebGPU (Firefox, older Safari, most in-app browsers) the canvas is
 * never shown and the poster underneath stands in. The poster is a frame of
 * the same renderer.
 */
---

<div class="sky" aria-hidden="true">
  <canvas class="hole"></canvas>
</div>

<style>
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: #000 url("/brand/sky.webp") center / cover no-repeat;
  }
  /* The renderer switches to its centred composition under 768px; the
     poster switches with it, so the two never disagree. */
  @media (max-width: 767px) {
    .sky {
      background-image: url("/brand/sky-portrait.webp");
    }
  }
  .hole {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    opacity: 0;
    transition: opacity 900ms var(--ease);
  }
  .hole.lit {
    opacity: 1;
  }
  /* Scrims, all local: the header stays legible over the ring, the words
     get a little more dark behind them where the disk reaches them, and
     the sky settles into the page ground instead of ending on a line. */
  .sky::before,
  .sky::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sky::before {
    background:
      linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0) 140px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.3) 38%, rgba(0, 0, 0, 0) 62%);
  }
  .sky::after {
    background: linear-gradient(rgba(13, 13, 13, 0) calc(100% - 160px), var(--ground));
  }
  @media (max-width: 767px) {
    .sky::before {
      background:
        linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0) 120px),
        radial-gradient(ellipse 80% 42% at 50% 50%, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0) 100%);
    }
  }
</style>

<script>
  import { createRenderer } from "../hero/renderer";

  const canvas = document.querySelector<HTMLCanvasElement>("canvas.hole");
  // ?poster forces the fallback, so the two can be compared on a machine
  // that has WebGPU.
  const wantsPoster = new URLSearchParams(location.search).has("poster");
  if (canvas && "gpu" in navigator && !wantsPoster) {
    const renderer = createRenderer({ canvas });
    renderer.ready.then(
      () => canvas.classList.add("lit"),
      // Any failure leaves the poster in place; the renderer has already
      // released what it created.
      () => {},
    );
    window.addEventListener("pagehide", () => renderer.dispose(), { once: true });
  }
</script>
