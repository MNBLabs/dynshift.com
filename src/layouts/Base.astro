---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME, DESCRIPTION, ADSENSE_PUBLISHER, GITHUB, GA_ID } from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** The social card, a path under /public. Defaults to the site's. */
  image?: string;
  /** Open Graph type: "article" for articles, "website" for the rest. */
  type?: "website" | "article";
  /** Further JSON-LD for this page, emitted after the Organization. */
  schema?: Record<string, unknown>[];
  /** Keep the page out of search indexes (drafts on the dev server). */
  noindex?: boolean;
  /** Article dates for Open Graph, ISO. */
  published?: string;
  modified?: string;
}

const {
  title,
  description = DESCRIPTION,
  image = "/og.png",
  type = "website",
  schema: extra = [],
  noindex = false,
  published,
  modified,
} = Astro.props as Props;

const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME}: an independent software studio`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  url: Astro.site?.href,
  logo: new URL("/icon-512.png", Astro.site).href,
  sameAs: [GITHUB],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {/*
      Icons, all generated from the supplied mark by tools/icons.mjs. The SVG
      follows the browser's light or dark chrome; the .ico is the tile for
      anything that cannot read SVG.
    */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="color-scheme" content="dark" />
    {/*
      Site ownership for AdSense. A static tag: it loads nothing and sets
      nothing, and AdSense reads it from the root domain on behalf of every
      subdomain. Keep it on every page.
    */}
    <meta name="google-adsense-account" content={`ca-${ADSENSE_PUBLISHER}`} />
    {/*
      The privacy runtime shared by all three DynShift sites. Synchronous and
      first, so Consent Mode defaults (denied in the EEA, the UK and
      Switzerland; personalisation denied under Global Privacy Control) exist
      before any Google script runs. It also gates analytics behind consent,
      lazy-loads ad slots and opens "Privacy settings".
    */}
    <script is:inline src="/privacy.js" data-ga={GA_ID} data-policy="/privacy/" data-cookies="/cookies/"></script>
    {/*
      The AdSense loader, in the head of every page and written here once so
      it cannot appear twice. Google asks for it in the head; it is also what
      delivers Google's consent message (a certified consent platform) to
      visitors in the EEA, the UK and Switzerland, and the US state opt-out,
      so it is not gated behind a banner of our own. Auto ads are off in the
      AdSense account: ads appear only in the placed slots.
    */}
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-${ADSENSE_PUBLISHER}`}
      crossorigin="anonymous"></script>
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    {extra.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--ground);
    border-radius: var(--r-s);
    font-weight: 600;
    text-decoration: none;
    z-index: 10;
  }
  .skip:focus-visible {
    top: 16px;
  }
</style>
