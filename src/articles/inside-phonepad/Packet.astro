---
/** The INPUT packet's layout, byte for byte, from protocol/PROTOCOL.md. */
const fields = [
  { name: "header", n: 4 },
  { name: "session", n: 4 },
  { name: "seq", n: 4 },
  { name: "clientTime", n: 4 },
  { name: "buttons", n: 2 },
  { name: "lx", n: 2 },
  { name: "ly", n: 2 },
  { name: "rx", n: 2 },
  { name: "ry", n: 2 },
  { name: "lt", n: 1 },
  { name: "rt", n: 1 },
  { name: "rttUs", n: 4 },
  { name: "mac", n: 8 },
];
const cell = 21;
const x0 = 20;
const top = 52;
const h = 44;
let off = 0;
const laid = fields.map((f) => {
  const r = { ...f, x: x0 + off * cell, w: f.n * cell, off };
  off += f.n;
  return r;
});
/* Every name fits inside its field except "buttons", which is labelled
   below with a leader. Byte boundaries are short notches on the bottom
   edge, clear of the names. */
const inside = (f: { name: string; w: number }) => f.name.length * 7 + 8 <= f.w;
const offsets = laid.map((f) => f.off).concat(40);
---

<svg viewBox="0 0 880 196" role="img" aria-labelledby="pp-pkt-t">
  <title id="pp-pkt-t">
    The 40-byte INPUT packet: a 4-byte header, session id, sequence number and phone timestamp; 2 bytes of
    buttons; four 2-byte stick axes; two 1-byte triggers; the phone's last measured round trip; and an
    8-byte truncated HMAC over the first 32 bytes.
  </title>
  <text x={x0} y="26" class="cap">authenticated: bytes 0 to 31</text>
  <path d={`M${x0} 34 V40 H${x0 + 32 * cell} V34`} class="brace" />
  <text x={x0 + 40 * cell} y="26" class="cap end">8-byte HMAC</text>
  <path d={`M${x0 + 32 * cell} 34 V40 H${x0 + 40 * cell} V34`} class="brace" />
  {
    laid.map((f) => (
      <g>
        <rect x={f.x + 1} y={top} width={f.w - 2} height={h} rx={5} class:list={["f", { mac: f.name === "mac" }]} />
        {Array.from({ length: f.n - 1 }, (_, k) => (
          <line x1={f.x + (k + 1) * cell} y1={top + h - 7} x2={f.x + (k + 1) * cell} y2={top + h - 1} class:list={["tick", { mac: f.name === "mac" }]} />
        ))}
        {inside(f) ? (
          <text x={f.x + f.w / 2} y={top + h / 2 + 4} class:list={["n", { mac: f.name === "mac" }]}>
            {f.name}
          </text>
        ) : (
          <g>
            <line x1={f.x + f.w / 2} y1={top + h + 4} x2={f.x + f.w / 2} y2={top + h + 20} class="lead" />
            <text x={f.x + f.w / 2} y={top + h + 34} class="n out">{f.name}</text>
          </g>
        )}
      </g>
    ))
  }
  {
    offsets.map((o) => (
      <text x={x0 + o * cell} y={178} class:list={["o", { start: o === 0, end: o === 40 }]}>
        {o}
      </text>
    ))
  }
</svg>

<style>
  svg {
    font-family: var(--mono);
  }
  .cap {
    fill: var(--teal);
    font-size: 12px;
  }
  .cap.end {
    text-anchor: end;
  }
  .brace {
    fill: none;
    stroke: var(--teal);
    stroke-opacity: 0.55;
  }
  .f {
    fill: var(--raised-2);
    stroke: var(--line-strong);
    stroke-width: 1.3;
  }
  .f.mac {
    fill: var(--teal);
    stroke: var(--teal);
  }
  .tick {
    stroke: var(--ink3);
  }
  .tick.mac {
    stroke: var(--ground);
    stroke-opacity: 0.45;
  }
  .n {
    text-anchor: middle;
    fill: var(--ink);
    font-size: 12px;
  }
  .n.out {
    fill: var(--ink2);
  }
  .n.mac {
    fill: var(--ground);
    font-weight: 600;
  }
  .lead {
    stroke: var(--line-strong);
  }
  .o {
    fill: var(--ink3);
    font-size: 10.5px;
    text-anchor: middle;
  }
  .o.start {
    text-anchor: start;
  }
  .o.end {
    text-anchor: end;
  }
</style>
