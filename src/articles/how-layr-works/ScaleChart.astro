---
/**
 * The rendered width of `w: 240` across screen widths, computed with the
 * formula LAYR ships (packages/model/src/ds.ts): inside each default frame,
 * size = 240 × clamp(0.9, screen / frame width, 1.15). Phones and tablets
 * measure the short side; this assumes portrait, where that is the width.
 */
const frames = [
  { name: "m", w: 390, from: 0 },
  { name: "t", w: 834, from: 600 },
  { name: "w", w: 1440, from: 1024 },
  { name: "uw", w: 2560, from: 1920 },
];
const V = 240;
const lo = 0.9;
const hi = 1.15;
const MIN = 320;
const MAX = 2560;
const size = (vw: number) => {
  const f = [...frames].reverse().find((fr) => vw >= fr.from)!;
  return V * Math.min(hi, Math.max(lo, vw / f.w));
};

const W = 820;
const H = 330;
const L = 56;
const R = 20;
const T = 34;
const B = 52;
const Y0 = 200;
const Y1 = 290;
const x = (v: number) => L + ((v - MIN) / (MAX - MIN)) * (W - L - R);
const y = (v: number) => H - B - ((v - Y0) / (Y1 - Y0)) * (H - T - B);

// Sample densely, and break the line at each frame boundary (the size steps there).
const segs: string[] = [];
frames.forEach((f, i) => {
  const a = Math.max(MIN, f.from);
  const b = Math.min(MAX, frames[i + 1]?.from ?? MAX) - (frames[i + 1] ? 0.01 : 0);
  const pts: string[] = [];
  for (let v = a; v <= b; v += 4) pts.push(`${x(v).toFixed(1)},${y(size(v)).toFixed(1)}`);
  pts.push(`${x(b).toFixed(1)},${y(size(b)).toFixed(1)}`);
  segs.push(`M${pts.join(" L")}`);
});
const exact = frames.filter((f) => f.w >= MIN && f.w <= MAX);
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="ly-scale-t">
  <title id="ly-scale-t">
    The width of a 240 design-pixel bar across screen widths from 320 to 2560 pixels. Inside each design frame
    it grows with the screen, held between 216 and 276 pixels, and it is exactly 240 at each frame's design
    width: 390, 834, 1440 and 2560. At 600, 1024 and 1920 the next frame takes over and the size steps back.
  </title>
  {
    [216, 240, 276].map((t) => (
      <g>
        <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} class:list={["grid", { mid: t === 240 }]} />
        <text x={L - 10} y={y(t) + 4} class="tick end">{t}</text>
      </g>
    ))
  }
  {
    frames.map((f, i) => (
      <g>
        {f.from > MIN && <line x1={x(f.from)} x2={x(f.from)} y1={T - 6} y2={H - B} class="frame" />}
        <text x={(x(Math.max(MIN, f.from)) + x(frames[i + 1]?.from ?? MAX)) / 2} y={T - 12} class="fname">
          {f.name}
        </text>
        {f.from > MIN && <text x={x(f.from)} y={H - B + 20} class="tick mid">{f.from}</text>}
      </g>
    ))
  }
  <text x={x(MIN)} y={H - B + 20} class="tick start">{MIN}</text>
  <text x={x(MAX)} y={H - B + 20} class="tick end">{MAX}</text>
  <text x={(L + W - R) / 2} y={H - 8} class="axis mid">Screen width, CSS pixels</text>

  {segs.map((d) => <path d={d} class="line" />)}
  {
    exact.map((f) => (
      <circle cx={x(f.w)} cy={y(V)} r={4.5} class="dot">
        <title>{`At ${f.w} px, the ${f.name} frame's design width, the bar is exactly 240 px`}</title>
      </circle>
    ))
  }
</svg>

<style>
  svg {
    font-family: var(--sans);
  }
  .grid {
    stroke: var(--line);
  }
  .grid.mid {
    stroke: var(--line-strong);
    stroke-dasharray: 4 5;
  }
  .frame {
    stroke: var(--line-strong);
  }
  .fname {
    text-anchor: middle;
    fill: var(--ink2);
    font-family: var(--mono);
    font-size: 13px;
  }
  .tick {
    fill: var(--ink3);
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .axis {
    fill: var(--ink2);
    font-size: 13px;
  }
  .end {
    text-anchor: end;
  }
  .mid {
    text-anchor: middle;
  }
  .start {
    text-anchor: start;
  }
  .line {
    fill: none;
    stroke: var(--ember);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .dot {
    fill: var(--ember);
    stroke: var(--raised);
    stroke-width: 2;
  }
</style>
