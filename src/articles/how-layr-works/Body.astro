:root { --ds: clamp(56.25rem, 1000 * 100vmin / 390, 71.875rem); }
@media (min-width: 600px)  { :root { --ds: clamp(56.25rem, 1000 * 100vmin / 834, 71.875rem); } }
@media (min-width: 1024px) { :root { --ds: clamp(56.25rem, 1000 * 100vw / 1440, 71.875rem); } }

/* w: 240 */
width: calc(240 * var(--ds) / 1000);`;

const paths = `SomePage.card                             // the object with .id(card)
DemoPage.scaffold.body.mid.column.text(1) // the second Text in that Column
