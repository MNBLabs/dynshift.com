---
/** The order every feature resolves in, from LAYR's EIED guide. */
const steps = ["schema default", "theme", "preset", "config", ".at(frame)", "writes", "injections", "final"];
const w = 112;
const gap = 10;
---

<svg viewBox={`0 0 ${steps.length * (w + gap) - gap + 20} 120`} role="img" aria-labelledby="ly-casc-t">
  <title id="ly-casc-t">
    The cascade: schema default, then theme, preset, config, per-frame config, writes, injections in exeOrder,
    and finally the resolved value.
  </title>
  {
    steps.map((s, i) => (
      <g>
        <rect x={10 + i * (w + gap)} y={30} width={w} height={48} rx={10} class:list={["st", { last: i === steps.length - 1 }]} />
        <text x={10 + i * (w + gap) + w / 2} y={59} class:list={["t", { last: i === steps.length - 1 }]}>{s}</text>
      </g>
    ))
  }
  <text x={10 + 6 * (w + gap) + w / 2} y={100} class="n">by exeOrder</text>
  <path d={`M10 18 H${steps.length * (w + gap) - gap + 4}`} class="dir" />
  <path d={`M${steps.length * (w + gap) - gap - 4} 12 l8 6 -8 6`} class="dir" />
</svg>

<style>
  svg {
    font-family: var(--mono);
  }
  .st {
    fill: var(--raised-2);
    stroke: var(--line-strong);
    stroke-width: 1.3;
  }
  .st.last {
    fill: none;
    stroke: var(--ember);
    stroke-width: 1.8;
  }
  .t {
    text-anchor: middle;
    fill: var(--ink);
    font-size: 11px;
  }
  .t.last {
    fill: var(--ember);
  }
  .n {
    text-anchor: middle;
    fill: var(--ink3);
    font-size: 11px;
  }
  .dir {
    fill: none;
    stroke: var(--ink3);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
